# --- Pflichtangaben ---
# Telegram: bei @BotFather einen Bot anlegen (/newbot) und das Token hier eintragen
TELEGRAM_BOT_TOKEN=
# Leer lassen, Bot starten und ihm schreiben: Er antwortet mit deiner Chat-ID.
TELEGRAM_CHAT_ID=

# Ort oder PLZ, z. B. Köln, 50672 oder „Neustadt - Hessen“
KA_LOCATION=
# Umkreis in km: 5, 10, 20, 30, 50, 100, 150 oder 200
KA_RADIUS_KM=5

# KI-Backend: cli = angemeldetes Claude Code (`claude -p`), api = Anthropic API
KA_JUDGE_BACKEND=cli
# nur für KA_JUDGE_BACKEND=api
ANTHROPIC_API_KEY=

# --- Optional ---
# Wörter, die eine Anzeige ohne KI-Aufruf aussortieren; * steht für beliebige Wortenden
# Beispiel: KA_EXCLUDE=baby*,kinderwagen,sperrmüll
KA_EXCLUDE=
# Meldung ab diesem KI-Score (0-10)
KA_MIN_SCORE=7
# Monatliches KI-Budget in Euro (bei cli: Listenpreis-Äquivalent, schützt das Abo-Kontingent), Umrechnungskurs USD->EUR
KA_BUDGET_EUR=5
KA_USD_EUR=0.92
# Abrufintervall in Sekunden. Bitte nicht zu klein wählen, um Kleinanzeigen nicht zu belasten.
KA_INTERVAL=300

# Karte (nur Heimnetz/VPN; direkte Zugriffe von öffentlichen IPs werden abgewiesen)
# KA_WEB_PORT leer lassen, um die Karte abzuschalten.
KA_WEB_HOST=0.0.0.0
KA_WEB_PORT=8672
# Adresse für die Karten-Links in Telegram, z. B. http://192.168.1.10:8672
# Nicht localhost eintragen: Telegram lehnt solche Buttons samt Nachricht ab.
KA_MAP_URL=
