# Hinter einem Proxy sieht der Bot nur 127.0.0.1. Die Zugriffsbeschränkung muss deshalb hier stehen.
server {
    listen 80;
    server_name karte.example.home;

    allow 127.0.0.0/8;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    allow 100.64.0.0/10;  # Tailscale
    deny all;

    location / {
        proxy_pass http://127.0.0.1:8672;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
